 "queries": [
  {
   "name": "qTracesEdit",
   "sql": "SELECT t.TraceID, t.SampleID, t.TraceNo, t.TraceCode, t.AtharBarcode, t.LiftLocation, t.Description, t.PhotoPath, t.StatusID, t.AtharRegDate, s.BatchID, b.CaseID, b.BatchNo, s.SampleNo, s.LineType, s.Description AS SampleDesc\r\nFROM (tblTraces AS t INNER JOIN tblSamples AS s ON t.SampleID = s.SampleID) INNER JOIN tblBatches AS b ON s.BatchID = b.BatchID\r\nORDER BY b.BatchNo, s.SampleNo, t.TraceNo;"
  },
  {
   "name": "qRunSamples",
   "sql": "SELECT rs.RunID, rs.SampleID, s.Barcode, s.Description, s.ItemCount, c.RefNo\r\nFROM ((tblRunSamples AS rs INNER JOIN tblSamples AS s ON rs.SampleID = s.SampleID) INNER JOIN tblBatches AS b ON s.BatchID = b.BatchID) INNER JOIN tblCases AS c ON b.CaseID = c.CaseID\r\nORDER BY s.Barcode;"
  },
  {
   "name": "qRunWork",
   "sql": "SELECT rs.RunID, rs.SampleID, r.UserID, r.RunDate, s.BatchID, IIf(s.PosCount Is Null,0,s.PosCount) AS PosItems, IIf(s.NegCount Is Null,0,s.NegCount) AS NegItems, IIf(s.PosCount Is Null,0,s.PosCount)+IIf(s.NegCount Is Null,0,s.NegCount) AS TestItems\r\nFROM (tblRunSamples AS rs INNER JOIN tblRuns AS r ON rs.RunID = r.RunID) INNER JOIN tblSamples AS s ON rs.SampleID = s.SampleID;"
  },
  {
   "name": "qRunWorkSum",
   "sql": "SELECT BatchID, UserID, Sum(TestItems) AS Tests, Sum(PosItems) AS PosTests, Sum(NegItems) AS NegTests\r\nFROM qRunWork\r\nGROUP BY BatchID, UserID;"
  },
  {
   "name": "qBatchFacts",
   "sql": "SELECT b.BatchID, b.CaseID, b.BatchNo, b.ReceivedDate, b.ReviewerID, Sum(IIf(s.LineType=2,1,0)) AS VisitLines\r\nFROM tblBatches AS b LEFT JOIN tblSamples AS s ON b.BatchID = s.BatchID\r\nGROUP BY b.BatchID, b.CaseID, b.BatchNo, b.ReceivedDate, b.ReviewerID;"
  },
  {
   "name": "qStaffCount",
   "sql": "SELECT BatchID, Count(*) AS StaffCount\r\nFROM tblBatchStaff\r\nGROUP BY BatchID;"
  },
  {
   "name": "qStatBase",
   "sql": "SELECT st.UserID, u.FullName, f.BatchID, f.CaseID, c.RefNo, a.AgencyName, f.BatchNo, f.ReceivedDate, Year(f.ReceivedDate) AS Yr, Month(f.ReceivedDate) AS Mo, DatePart(\"q\",f.ReceivedDate) AS Qt, st.PosCount+st.NegCount+st.UnkCount AS Samples, st.PosCount, st.NegCount, st.UnkCount, st.ProcTraces, st.VisitTraces, IIf(st.PosCount+st.NegCount+st.UnkCount>0,1,0) AS ProcCases, IIf(f.VisitLines>0 And (st.VisitTraces>0 Or sc.StaffCount=1),1,0) AS VisitCases, IIf(sc.StaffCount>1,1,0) AS SharedFlag, IIf(w.Tests Is Null,0,w.Tests) AS Tests, IIf(w.PosTests Is Null,0,w.PosTests) AS PosTests, IIf(w.NegTests Is Null,0,w.NegTests) AS NegTests\r\nFROM (((((tblBatchStaff AS st INNER JOIN qBatchFacts AS f ON st.BatchID = f.BatchID) INNER JOIN tblCases AS c ON f.CaseID = c.CaseID) INNER JOIN tblUsers AS u ON st.UserID = u.UserID) INNER JOIN qStaffCount AS sc ON st.BatchID = sc.BatchID) LEFT JOIN tblAgencies AS a ON c.AgencyID = a.AgencyID) LEFT JOIN qRunWorkSum AS w ON st.BatchID = w.BatchID AND st.UserID = w.UserID;"
  },
  {
   "name": "الاحصائية الشهرية",
   "sql": "SELECT FullName & '' AS [القائم بالفحص], Sum(VisitCases) AS [عدد قضايا الانتقال], Sum(VisitTraces) AS [عدد آثار الانتقال], Sum(ProcCases) AS [عدد قضايا المعالجة], Sum(Samples) AS [عدد العينات], Sum(PosCount) AS [الإيجابي], Sum(NegCount) AS [السلبي], Sum(UnkCount) AS [لم يتبين], Sum(ProcTraces) AS [عدد الآثار], Count(*) AS [المنجز من القضايا], Sum(Tests) AS [عدد الفحوص], Sum(PosTests) AS [الفحص الإيجابي], Sum(NegTests) AS [الفحص السلبي]\r\nFROM qStatBase\r\nWHERE [Yr]=[TempVars]![StatYear] AND [Mo]=[TempVars]![StatFrom]\r\nGROUP BY FullName\r\nORDER BY FullName;"
  },
  {
   "name": "احصائية الموظف",
   "sql": "SELECT FullName & '' AS [القائم بالفحص], Sum(VisitCases) AS [عدد قضايا الانتقال], Sum(VisitTraces) AS [عدد آثار الانتقال], Sum(ProcCases) AS [عدد قضايا المعالجة], Sum(Samples) AS [عدد العينات], Sum(PosCount) AS [الإيجابي], Sum(NegCount) AS [السلبي], Sum(UnkCount) AS [لم يتبين], Sum(ProcTraces) AS [عدد الآثار], Count(*) AS [المنجز من القضايا], Sum(Tests) AS [عدد الفحوص], Sum(PosTests) AS [الفحص الإيجابي], Sum(NegTests) AS [الفحص السلبي]\r\nFROM qStatBase\r\nWHERE [Yr]=[TempVars]![StatYear] AND [Mo] Between [TempVars]![StatFrom] And [TempVars]![StatTo]\r\nGROUP BY FullName\r\nORDER BY FullName;"
  },
  {
   "name": "احصائية الربع",
   "sql": "SELECT FullName & '' AS [القائم بالفحص], Qt AS [الربع], Sum(VisitCases) AS [عدد قضايا الانتقال], Sum(VisitTraces) AS [عدد آثار الانتقال], Sum(ProcCases) AS [عدد قضايا المعالجة], Sum(Samples) AS [عدد العينات], Sum(PosCount) AS [الإيجابي], Sum(NegCount) AS [السلبي], Sum(UnkCount) AS [لم يتبين], Sum(ProcTraces) AS [عدد الآثار], Count(*) AS [المنجز من القضايا], Sum(Tests) AS [عدد الفحوص], Sum(PosTests) AS [الفحص الإيجابي], Sum(NegTests) AS [الفحص السلبي]\r\nFROM qStatBase\r\nWHERE [Yr]=[TempVars]![StatYear]\r\nGROUP BY FullName, Qt\r\nORDER BY FullName, Qt;"
  },
  {
   "name": "qReviewsYear",
   "sql": "SELECT ReviewerID, Count(*) AS Reviews\r\nFROM tblBatches\r\nWHERE ReviewerID Is Not Null AND Year(ReceivedDate)=[TempVars]![StatYear]\r\nGROUP BY ReviewerID;"
  },
  {
   "name": "qStatYearSums",
   "sql": "SELECT UserID, FullName & '' AS [القائم بالفحص], Sum(VisitCases) AS [عدد قضايا الانتقال], Sum(VisitTraces) AS [عدد آثار الانتقال], Sum(ProcCases) AS [عدد قضايا المعالجة], Sum(Samples) AS [عدد العينات], Sum(PosCount) AS [الإيجابي], Sum(NegCount) AS [السلبي], Sum(UnkCount) AS [لم يتبين], Sum(ProcTraces) AS [عدد الآثار], Count(*) AS [المنجز من القضايا], Sum(Tests) AS [عدد الفحوص], Sum(PosTests) AS [الفحص الإيجابي], Sum(NegTests) AS [الفحص السلبي]\r\nFROM qStatBase\r\nWHERE [Yr]=[TempVars]![StatYear]\r\nGROUP BY UserID, FullName;"
  },
  {
   "name": "الاحصائية السنوية",
   "sql": "SELECT y.*, IIf(r.Reviews Is Null,0,r.Reviews) AS [مراجعة]\r\nFROM qStatYearSums AS y LEFT JOIN qReviewsYear AS r ON y.UserID = r.ReviewerID\r\nORDER BY y.[القائم بالفحص];"
  },
  {
   "name": "احصائية الفحوصات",
   "sql": "SELECT FullName & '' AS [القائم بالفحص], RefNo & '' AS [رقم المرجع], BatchNo+0 AS [المجموعة], DateValue(ReceivedDate) AS [تاريخ الورود], AgencyName & '' AS [الجهة], Samples+0 AS [عدد العينات], PosCount+0 AS [الإيجابي], NegCount+0 AS [السلبي], UnkCount+0 AS [لم يتبين], ProcTraces+0 AS [عدد الآثار], VisitTraces+0 AS [عدد آثار الانتقال], Tests+0 AS [عدد الفحوص], PosTests+0 AS [الفحص الإيجابي], NegTests+0 AS [الفحص السلبي], IIf(SharedFlag=1,\"نعم\",\"\") AS [مشتركة]\r\nFROM qStatBase\r\nWHERE [Yr]=[TempVars]![StatYear] AND [Mo] Between [TempVars]![StatFrom] And [TempVars]![StatTo]\r\nORDER BY ReceivedDate, RefNo, FullName;"
  },
  {
   "name": "الاحصائية العامة",
   "sql": "SELECT Sum(VisitCases) AS [عدد قضايا الانتقال], Sum(VisitTraces) AS [عدد آثار الانتقال], Sum(ProcCases) AS [عدد قضايا المعالجة], Sum(Samples) AS [عدد العينات], Sum(PosCount) AS [الإيجابي], Sum(NegCount) AS [السلبي], Sum(UnkCount) AS [لم يتبين], Sum(ProcTraces) AS [عدد الآثار], Count(*) AS [المنجز من القضايا], Sum(Tests) AS [عدد الفحوص], Sum(PosTests) AS [الفحص الإيجابي], Sum(NegTests) AS [الفحص السلبي]\r\nFROM qStatBase\r\nWHERE [Yr]=[TempVars]![StatYear] AND [Mo] Between [TempVars]![StatFrom] And [TempVars]![StatTo];"
  },
  {
   "name": "qReviewCases",
   "sql": "SELECT ReviewerID, CaseID, Count(*) AS Batches\r\nFROM tblBatches\r\nWHERE ReviewerID Is Not Null AND Year(ReceivedDate)=[TempVars]![StatYear] AND Month(ReceivedDate) Between [TempVars]![StatFrom] And [TempVars]![StatTo]\r\nGROUP BY ReviewerID, CaseID;"
  },
  {
   "name": "احصائية المراجعين",
   "sql": "SELECT u.FullName & '' AS [القائم بالمراجعة], Count(*) AS [عدد القضايا], Sum(q.Batches) AS [عدد المجموعات]\r\nFROM qReviewCases AS q INNER JOIN tblUsers AS u ON q.ReviewerID = u.UserID\r\nGROUP BY u.FullName\r\nORDER BY u.FullName;"
  },
  {
   "name": "احصائية القضايا حسب الجهات",
   "sql": "TRANSFORM Count(c.CaseID) AS n\r\nSELECT IIf(a.AgencyName Is Null,'(بلا جهة)',a.AgencyName) AS [الجهة], Count(c.CaseID) AS [الإجمالي]\r\nFROM tblCases AS c LEFT JOIN tblAgencies AS a ON c.AgencyID = a.AgencyID\r\nWHERE Year(c.CaseDate)=2026\r\nGROUP BY IIf(a.AgencyName Is Null,'(بلا جهة)',a.AgencyName)\r\nPIVOT Format(c.CaseDate,'mm') IN ('01','02','03','04','05','06','07','08','09','10','11','12');"
  },
  {
   "name": "qStockBalance",
   "sql": "SELECT m.MaterialID, m.MaterialName & '' AS [المادة], m.Unit & '' AS [الوحدة], m.MinStock, IIf(Sum(IIf(s.MoveType=1,s.Qty,IIf(s.MoveType=2,-s.Qty,0))) Is Null,0,Sum(IIf(s.MoveType=1,s.Qty,IIf(s.MoveType=2,-s.Qty,0)))) AS Balance, Min(IIf(s.MoveType=1 And s.ExpiryDate>=Date(),s.ExpiryDate,Null)) AS NearestExpiry, Max(s.MoveDate) AS LastMove\r\nFROM tblMaterials AS m LEFT JOIN tblStockMoves AS s ON m.MaterialID = s.MaterialID\r\nWHERE m.IsActive=True\r\nGROUP BY m.MaterialID, m.MaterialName, m.Unit, m.MinStock\r\nORDER BY m.MaterialName;"
  },
  {
   "name": "qStockMoves",
   "sql": "SELECT s.MoveID, s.MaterialID, s.MoveDate, IIf(s.MoveType=1,'إضافة','صرف') AS MoveName, s.MoveType, s.Qty, s.LotNo, s.ExpiryDate, l.LocationName, u.FullName, s.Notes\r\nFROM (tblStockMoves AS s LEFT JOIN tblStorageLocations AS l ON s.LocationID = l.LocationID) LEFT JOIN tblUsers AS u ON s.UserID = u.UserID\r\nORDER BY s.MoveDate DESC, s.MoveID DESC;"
  },
  {
   "name": "qCaseFind",
   "sql": "SELECT CaseID, RefNo, ForensicNo, Format(CaseDate,'yyyy/mm/dd') AS Dated\r\nFROM tblCases\r\nORDER BY CaseID DESC;"
  }
 ],
